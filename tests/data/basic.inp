[TITLE]
;; AOWIS SWMM native solver smoke test: a small rain-fed drainage system

[OPTIONS]
FLOW_UNITS           CMS
INFILTRATION         HORTON
FLOW_ROUTING         DYNWAVE
LINK_OFFSETS         DEPTH
START_DATE           01/01/2020
START_TIME           00:00:00
REPORT_START_DATE    01/01/2020
REPORT_START_TIME    00:00:00
END_DATE             01/01/2020
END_TIME             02:00:00
REPORT_STEP          00:05:00
WET_STEP             00:01:00
DRY_STEP             00:05:00
ROUTING_STEP         00:00:10
THREADS              1

[EVAPORATION]
CONSTANT             0.0

[RAINGAGES]
;;Name   Format     Interval  SCF  Source
Rain     INTENSITY  0:05      1.0  TIMESERIES Storm

[SUBCATCHMENTS]
;;Name  RainGage Outlet  Area(ha) Imperv(%) Width(m) Slope(%) CurbLen
Basin   Rain     J1      1.0      50        100      1.0      0

[SUBAREAS]
;;Name  N-Imp N-Perv S-Imp S-Perv PctZero RouteTo
Basin   0.01  0.1    1.0   5.0    25      OUTLET

[INFILTRATION]
;;Name  MaxRate MinRate Decay DryTime MaxInfil
Basin   75      10      4     7       0

[JUNCTIONS]
;;Name Elevation MaxDepth InitDepth SurDepth Aponded
J1     100       2.0      0         0        0

[OUTFALLS]
;;Name Elevation Type Gated
O1     99        FREE NO

[CONDUITS]
;;Name From To Length Roughness InOffset OutOffset InitFlow MaxFlow
Pipe   J1   O1 100    0.013     0        0         0        0

[XSECTIONS]
;;Name Shape    Geom1 Geom2 Geom3 Geom4 Barrels
Pipe   CIRCULAR 0.5   0     0     0     1

[TIMESERIES]
;;Name Date Time Value (intensity in mm/hour)
Storm        00:00 0
Storm        00:10 30
Storm        00:40 30
Storm        00:45 0
Storm        02:00 0

[REPORT]
INPUT          NO
CONTROLS       NO
SUBCATCHMENTS  ALL
NODES          ALL
LINKS          ALL
